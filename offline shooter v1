<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apex Tactical - First-Person Night Survival Simulator</title>
    <!-- Tailwind CSS for modern responsive overlay screens -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: #030712;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            user-select: none;
            -webkit-user-select: none;
        }


        /* Dynamic Crosshair */
        #crosshairContainer {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 40px;
            height: 40px;
            pointer-events: none;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: transform 0.1s ease;
        }
        .crosshair-dot {
            width: 4px;
            height: 4px;
            background: #22d3ee;
            border-radius: 50%;
            box-shadow: 0 0 6px #22d3ee;
        }
        .crosshair-line {
            position: absolute;
            background: rgba(34, 211, 238, 0.8);
            box-shadow: 0 0 4px rgba(34, 211, 238, 0.5);
        }
        .ch-top { top: 4px; width: 2px; height: 8px; }
        .ch-bottom { bottom: 4px; width: 2px; height: 8px; }
        .ch-left { left: 4px; width: 8px; height: 2px; }
        .ch-right { right: 4px; width: 8px; height: 2px; }


        /* ADS Scope Overlay */
        #adsOverlay {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle, rgba(0,0,0,0) 35%, rgba(2,4,8,0.95) 68%, #000 100%);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 5;
        }
        .scope-crosshair {
            width: 240px;
            height: 240px;
            border: 2px solid rgba(239, 68, 68, 0.7);
            border-radius: 50%;
            position: relative;
            box-shadow: inset 0 0 25px rgba(239, 68, 68, 0.4);
        }
        .scope-crosshair::before {
            content: '';
            position: absolute;
            top: 50%; left: 5px; right: 5px; height: 1px;
            background: rgba(239, 68, 68, 0.9);
        }
        .scope-crosshair::after {
            content: '';
            position: absolute;
            left: 50%; top: 5px; bottom: 5px; width: 1px;
            background: rgba(239, 68, 68, 0.9);
        }


        /* Minimap Canvas */
        #minimapCanvas {
            width: 130px;
            height: 130px;
            background: rgba(15, 23, 42, 0.85);
            border: 2px solid rgba(56, 189, 248, 0.4);
            border-radius: 50%;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.7);
        }


        /* 3D Zombie Health Bar Container */
        .zombie-hp-bar-container {
            position: absolute;
            width: 48px;
            height: 6px;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 3px;
            transform: translate(-50%, -50%);
            pointer-events: none;
            overflow: hidden;
            display: none;
            z-index: 5;
        }
        .zombie-hp-fill {
            height: 100%;
            background: linear-gradient(to right, #ef4444, #f59e0b);
            width: 100%;
            transition: width 0.1s ease;
        }


        /* Damage Screen Flash */
        #damageFlash {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle, transparent 40%, rgba(220, 38, 38, 0.55) 100%);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.15s ease;
            z-index: 4;
        }


        @keyframes floatCatch {
            0% { transform: translateY(-80px) rotate(-25deg); opacity: 0; }
            60% { transform: translateY(10px) rotate(5deg); opacity: 1; }
            100% { transform: translateY(0) rotate(0deg); opacity: 1; }
        }
        .catch-animation { animation: floatCatch 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    </style>
</head>
<body class="relative w-screen h-screen overflow-hidden">


    <!-- 3D WebGL Canvas -->
    <div id="canvasContainer" class="absolute inset-0"></div>


    <!-- DOM CONTAINER FOR 3D ZOMBIE HEALTH BARS -->
    <div id="zombieHealthBarsOverlay" class="absolute inset-0 pointer-events-none overflow-hidden z-6"></div>


    <!-- DAMAGE FLASH OVERLAY -->
    <div id="damageFlash"></div>


    <!-- CROSSHAIR -->
    <div id="crosshairContainer">
        <div class="crosshair-dot"></div>
        <div class="crosshair-line ch-top"></div>
        <div class="crosshair-line ch-bottom"></div>
        <div class="crosshair-line ch-left"></div>
        <div class="crosshair-line ch-right"></div>
    </div>


    <!-- ADS SCOPE OVERLAY -->
    <div id="adsOverlay">
        <div class="scope-crosshair"></div>
    </div>


    <!-- HUD OVERLAY -->
    <div id="hud" class="absolute inset-0 pointer-events-none p-6 flex flex-col justify-between hidden z-10">
        <!-- Top Bar -->
        <div class="flex justify-between items-start">
            <!-- Health & Stamina & Explicit HP/Ammo Bar Panel -->
            <div class="flex flex-col gap-2 bg-slate-900/85 backdrop-blur border border-slate-800 p-4 rounded-xl shadow-xl w-72">
                <div class="flex justify-between text-xs font-bold text-slate-400 uppercase tracking-wider">
                    <span>Integrity (HP Bar)</span>
                    <span id="hpText" class="text-emerald-400">100 / 100</span>
                </div>
                <div class="w-full h-3 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700 shadow-inner">
                    <div id="healthBar" class="h-full bg-gradient-to-r from-emerald-500 to-cyan-400 rounded-full transition-all duration-200" style="width: 100%;"></div>
                </div>


                <div class="flex justify-between text-xs font-bold text-slate-400 uppercase tracking-wider mt-1">
                    <span>Ammunition Bar</span>
                    <span id="ammoBarText" class="text-amber-400">30 / 30</span>
                </div>
                <div class="w-full h-3 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700 shadow-inner">
                    <div id="ammoBarFill" class="h-full bg-gradient-to-r from-amber-500 to-yellow-300 rounded-full transition-all duration-150" style="width: 100%;"></div>
                </div>


                <div class="flex justify-between text-xs font-bold text-slate-400 uppercase tracking-wider mt-1">
                    <span>Stamina (Shift)</span>
                    <span id="staminaText" class="text-sky-400">100%</span>
                </div>
                <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700">
                    <div id="staminaBar" class="h-full bg-sky-400 rounded-full transition-all duration-100" style="width: 100%;"></div>
                </div>
            </div>


            <!-- Match Score & Wave Info -->
            <div class="flex gap-4">
                <div class="bg-amber-950/85 backdrop-blur border border-amber-800/60 px-6 py-3 rounded-xl text-center shadow-xl">
                    <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">Zombies Cleared</div>
                    <div id="scoreDisplay" class="text-2xl font-black text-amber-200 tracking-tight">0</div>
                </div>
                <div class="bg-amber-950/85 backdrop-blur border border-amber-800/60 px-6 py-3 rounded-xl text-center shadow-xl">
                    <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">Sunrise Horde Wave</div>
                    <div id="waveDisplay" class="text-2xl font-black text-orange-400 tracking-tight">1</div>
                </div>
            </div>


            <!-- Minimap & Radar -->
            <div class="flex flex-col items-center bg-slate-900/85 backdrop-blur border border-slate-800 p-3 rounded-2xl shadow-xl">
                <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider mb-2">Sunrise Radar</div>
                <canvas id="minimapCanvas" width="130" height="130"></canvas>
            </div>
        </div>


        <!-- Bottom Bar (Ammo, Weapon, Kill Feed, Interaction Prompt) -->
        <div class="flex justify-between items-end">
            <!-- Kill Feed Log -->
            <div id="killFeed" class="flex flex-col gap-1 text-xs font-medium text-amber-200/80 max-w-xs"></div>


            <!-- Interaction Prompt Notification -->
            <div id="interactionPrompt" class="bg-amber-950/90 border border-amber-500 text-amber-300 px-6 py-3 rounded-xl font-bold text-sm shadow-2xl hidden animate-pulse">
                PRESS <span class="text-white underline">F</span> TO EQUIP <span id="promptWeaponName" class="text-yellow-400"></span>
            </div>


            <!-- Weapon & Ammo Status -->
            <div class="bg-amber-950/85 backdrop-blur border border-amber-800/60 px-6 py-4 rounded-xl shadow-xl flex items-center gap-6">
                <div>
                    <div id="weaponName" class="text-xs font-bold text-orange-400 uppercase tracking-widest">TACTICAL RIFLE MK-II</div>
                    <div class="text-[10px] text-amber-300/70">Fire Mode: <span class="text-emerald-400">AUTO / ADS (Right Click)</span></div>
                </div>
                <div class="border-l border-amber-800/50 pl-6 text-right">
                    <div class="text-xs text-amber-300/70 uppercase font-bold">Ammo Count</div>
                    <div class="text-3xl font-black text-white tracking-wider"><span id="ammoCurrent">30</span><span class="text-amber-500/85 text-xl"> / <span id="ammoReserve">120</span></span></div>
                </div>
            </div>
        </div>
    </div>


    <!-- UI OVERLAY: START MENU -->
    <div id="startScreen" class="absolute inset-0 bg-slate-950/95 backdrop-blur-md flex flex-col items-center justify-center z-20 p-6">
        <div id="startCard" class="max-w-md w-full bg-amber-950/95 border border-amber-500/30 rounded-2xl p-8 text-center shadow-2xl relative overflow-hidden catch-animation">
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
           
            <div class="w-16 h-16 bg-amber-500/20 border border-amber-500/50 rounded-2xl mx-auto flex items-center justify-center mb-4 shadow-lg shadow-amber-500/20">
                <svg class="w-8 h-8 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
            </div>


            <h1 class="text-3xl font-black tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-500 mb-1">DAWN SURVIVOR</h1>
            <p class="text-amber-300/70 text-xs uppercase tracking-widest mb-6">Sunrise Tactical Outpost Simulator</p>
           
            <div class="space-y-2 text-left bg-slate-950/60 p-4 rounded-xl border border-amber-900/40 text-xs text-amber-100 mb-6">
                <div class="flex justify-between"><span><strong class="text-amber-400">W, A, S, D:</strong></span> <span>Move & Escape</span></div>
                <div class="flex justify-between"><span><strong class="text-amber-400">SHIFT:</strong></span> <span>Sprint</span></div>
                <div class="flex justify-between"><span><strong class="text-amber-400">MOUSE:</strong></span> <span>First-Person Aim</span></div>
                <div class="flex justify-between"><span><strong class="text-amber-400">LEFT CLICK:</strong></span> <span>Fire Weapon</span></div>
                <div class="flex justify-between"><span><strong class="text-amber-400">RIGHT CLICK:</strong></span> <span>Ironsights (ADS)</span></div>
                <div class="flex justify-between"><span><strong class="text-amber-400">R KEY:</strong></span> <span>Reload</span></div>
                <div class="flex justify-between"><span><strong class="text-amber-400">F KEY:</strong></span> <span>Pickup Dropped Weapon</span></div>
            </div>


            <button id="startButton" class="w-full py-4 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-slate-950 font-extrabold rounded-xl shadow-lg transition transform active:scale-95 cursor-pointer">
                START DAWN SURVIVAL
            </button>
        </div>
    </div>


    <!-- UI OVERLAY: GAME OVER SCREEN -->
    <div id="gameOverScreen" class="absolute inset-0 bg-slate-950/94 backdrop-blur-md flex flex-col items-center justify-center hidden z-20 p-6">
        <div class="max-w-md w-full bg-slate-900/95 border border-red-500/40 rounded-2xl p-8 text-center shadow-2xl">
            <h2 class="text-3xl font-black tracking-wider text-red-500 mb-1">SURVIVED UNTIL DAWN</h2>
            <p class="text-slate-400 text-xs uppercase tracking-widest mb-6">Infected Horde Overran the Outpost</p>


            <div class="bg-slate-950/60 p-4 rounded-xl border border-slate-800 mb-6 space-y-2">
                <div class="flex justify-between text-sm"><span class="text-slate-400">Zombies Terminated:</span> <span id="finalKills" class="font-bold text-amber-400">0</span></div>
                <div class="flex justify-between text-sm"><span class="text-slate-400">Sunrise Wave Reached:</span> <span id="finalWave" class="font-bold text-orange-400">1</span></div>
            </div>


            <button id="restartButton" class="w-full py-4 bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-extrabold rounded-xl shadow-lg transition transform active:scale-95 cursor-pointer">
                TRY AGAIN
            </button>
        </div>
    </div>


    <!-- Three.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>


    <script>
        // --- GAME & THREE.JS SETUP ---
        let scene, camera, renderer;
        let gameState = 'START'; // START, PLAYING, GAMEOVER
        let keys = {}; // Declare global keys tracker for keyboard state


        // Weapon Types Definition
        const WEAPONS = {
            PISTOL: { name: 'M9 PISTOL', damage: 35, maxAmmo: 12, fireRate: 0.25, color: 0x64748b, tracerColor: 0xe2e8f0, speed: 16.0 },
            RIFLE: { name: 'TACTICAL RIFLE MK-II', damage: 25, maxAmmo: 30, fireRate: 0.12, color: 0x334155, tracerColor: 0xfef08a, speed: 18.0 },
            SNIPER: { name: 'AX-50 SNIPER RIFLE', damage: 120, maxAmmo: 5, fireRate: 0.9, color: 0x0284c7, tracerColor: 0x38bdf8, speed: 28.0 },
            MACHINEGUN: { name: 'M249 LMG', damage: 22, maxAmmo: 100, fireRate: 0.08, color: 0xd97706, tracerColor: 0xf97316, speed: 15.0 }
        };


        let player = {
            x: 0,
            y: 1.7, // First person camera height
            z: 0,
            radius: 0.8,
            speed: 0.16,
            sprintMultiplier: 1.6,
            maxHealth: 100,
            health: 100,
            stamina: 100,
            maxStamina: 100,
            isSprinting: false,
            isADS: false,
            currentWeaponKey: 'RIFLE',
            ammo: 30,
            maxAmmo: 30,
            reserveAmmo: 120,
            isReloading: false,
            reloadTimer: 0,
            recoilPitch: 0,
            lastShotTime: 0
        };


        let weaponMeshGroup;
        let obstacles = [];
        let zombies = [];
        let droppedWeapons = []; // Array of dropped weapon pickups
        let bullets = [];
        let particles = [];
        let starField;


        let score = 0;
        let wave = 1;
        let zombiesToSpawn = 0;
        let waveTimer = 0;


        // Minimap context
        const minimapCanvas = document.getElementById('minimapCanvas');
        const minimapCtx = minimapCanvas.getContext('2d');


        function init() {
            // Scene Setup - Sunrise Environment with Warm Golden Glow & Light Fog
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xfde047); // Golden dawn horizon background
            scene.fog = new THREE.FogExp2(0xf59e0b, 0.006); // Soft warm morning fog


            // Camera Setup (First-Person FOV)
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);


            // Renderer Setup
            renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            document.getElementById('canvasContainer').appendChild(renderer.domElement);


            // Sunrise Lighting - Warm Golden Sun and Orange Ambience
            const ambientLight = new THREE.AmbientLight(0xfef08a, 0.7);
            scene.add(ambientLight);


            const sunLight = new THREE.DirectionalLight(0xffedd5, 1.4);
            sunLight.position.set(250, 80, 200); // Low sun in the horizon (Sunrise)
            sunLight.castShadow = true;
            sunLight.shadow.mapSize.width = 2048;
            sunLight.shadow.mapSize.height = 2048;
            sunLight.shadow.camera.near = 0.5;
            sunLight.shadow.camera.far = 500;
            const d = 160;
            sunLight.shadow.camera.left = -d;
            sunLight.shadow.camera.right = d;
            sunLight.shadow.camera.top = d;
            sunLight.shadow.camera.bottom = -d;
            scene.add(sunLight);


            // Create Morning Sky Clouds / Glow Particles
            const starsGeo = new THREE.BufferGeometry();
            const starsCount = 300;
            const starPositions = new Float32Array(starsCount * 3);
            for(let i = 0; i < starsCount * 3; i += 3) {
                starPositions[i] = (Math.random() - 0.5) * 800;
                starPositions[i+1] = Math.random() * 120 + 30;
                starPositions[i+2] = (Math.random() - 0.5) * 800;
            }
            starsGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
            const starsMat = new THREE.PointsMaterial({ color: 0xffedd5, size: 2.0, transparent: true, opacity: 0.6 });
            starField = new THREE.Points(starsGeo, starsMat);
            scene.add(starField);


            // Create Morning Terrain Ground (Golden amber grassland)
            const floorGeo = new THREE.PlaneGeometry(400, 400, 64, 64);
            const floorMat = new THREE.MeshStandardMaterial({ color: 0x78350f, roughness: 0.85, metalness: 0.1 });
            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            floor.receiveShadow = true;
            scene.add(floor);


            // Create First-Person Weapon Model attached to camera
            weaponMeshGroup = new THREE.Group();
            buildWeaponMesh();
            camera.add(weaponMeshGroup);
            scene.add(camera);


            // Generate Environment Obstacles & Outpost Containers
            createEnvironment();


            // Event Listeners
            window.addEventListener('resize', onWindowResize);
            window.addEventListener('keydown', e => {
                keys[e.code] = true;
                if(e.code === 'KeyR') reloadWeapon();
                if(e.code === 'KeyF') pickupNearestWeapon();
            });
            window.addEventListener('keyup', e => { keys[e.code] = false; });


            const canvasEl = document.getElementById('canvasContainer');
            canvasEl.addEventListener('click', () => {
                if(gameState === 'PLAYING') {
                    document.body.requestPointerLock();
                }
            });


            window.addEventListener('mousemove', e => {
                if (document.pointerLockElement === document.body && gameState === 'PLAYING') {
                    mouseX -= e.movementX * 0.0025;
                    mouseY -= e.movementY * 0.0025;
                    mouseY = Math.max(-1.2, Math.min(1.2, mouseY));
                }
            });


            window.addEventListener('mousedown', e => {
                if (document.pointerLockElement === document.body && gameState === 'PLAYING') {
                    if (e.button === 0) isMouseDown = true;
                    if (e.button === 2) {
                        isRightMouseDown = true;
                        player.isADS = true;
                        document.getElementById('adsOverlay').style.display = 'flex';
                    }
                }
            });


            window.addEventListener('mouseup', e => {
                if (e.button === 0) isMouseDown = false;
                if (e.button === 2) {
                    isRightMouseDown = false;
                    player.isADS = false;
                    document.getElementById('adsOverlay').style.display = 'none';
                }
            });


            window.addEventListener('contextmenu', e => e.preventDefault());
        }


        function buildWeaponMesh() {
            while(weaponMeshGroup.children.length > 0){
                weaponMeshGroup.remove(weaponMeshGroup.children[0]);
            }


            const wData = WEAPONS[player.currentWeaponKey];
            const gunBodyGeo = new THREE.BoxGeometry(0.1, 0.12, player.currentWeaponKey === 'SNIPER' ? 1.1 : 0.7);
            const gunMat = new THREE.MeshStandardMaterial({ color: wData.color, metalness: 0.85, roughness: 0.25 });
            const gunMesh = new THREE.Mesh(gunBodyGeo, gunMat);
            gunMesh.position.set(0.25, -0.22, -0.5);
            weaponMeshGroup.add(gunMesh);


            const barrelGeo = new THREE.CylinderGeometry(0.025, 0.025, player.currentWeaponKey === 'SNIPER' ? 0.7 : 0.4, 8);
            barrelGeo.rotateX(Math.PI / 2);
            const barrelMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, metalness: 0.95 });
            const barrelMesh = new THREE.Mesh(barrelGeo, barrelMat);
            barrelMesh.position.set(0.25, -0.2, player.currentWeaponKey === 'SNIPER' ? -0.85 : -0.75);
            weaponMeshGroup.add(barrelMesh);


            if(player.currentWeaponKey === 'SNIPER') {
                const scopeGeo = new THREE.BoxGeometry(0.05, 0.07, 0.2);
                const scopeMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.9 });
                const scopeMesh = new THREE.Mesh(scopeGeo, scopeMat);
                scopeMesh.position.set(0.25, -0.14, -0.5);
                weaponMeshGroup.add(scopeMesh);
            }
        }


        function switchWeapon(newKey) {
            player.currentWeaponKey = newKey;
            const wData = WEAPONS[newKey];
            player.maxAmmo = wData.maxAmmo;
            player.ammo = wData.maxAmmo;
            player.reserveAmmo += 60;
            updateAmmoBar();
            buildWeaponMesh();
            document.getElementById('weaponName').innerText = wData.name;
            addLog(`⚡ Auto-equipped new weapon: ${wData.name}!`);
        }


        function createEnvironment() {
            const matList = [
                new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.7 }), // Concrete barrier
                new THREE.MeshStandardMaterial({ color: 0x451a03, roughness: 0.8 }), // Rust cargo crate
                new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.5 })  // Steel barricade
            ];


            for (let i = 0; i < 40; i++) {
                const w = Math.random() * 6 + 3;
                const h = Math.random() * 4 + 2;
                const d = Math.random() * 6 + 3;
                const geo = new THREE.BoxGeometry(w, h, d);
                const mat = matList[Math.floor(Math.random() * matList.length)];
                const obstacle = new THREE.Mesh(geo, mat);


                let x, z;
                do {
                    x = (Math.random() - 0.5) * 340;
                    z = (Math.random() - 0.5) * 340;
                } while (Math.hypot(x, z) < 18);


                obstacle.position.set(x, h / 2, z);
                obstacle.castShadow = true;
                obstacle.receiveShadow = true;
                scene.add(obstacle);
                obstacles.push(obstacle);
            }
        }


        function spawnZombie() {
            const isBrute = wave >= 3 && Math.random() < 0.25;


            const zombieGroup = new THREE.Group();


            const bodyGeo = new THREE.CylinderGeometry(isBrute ? 0.9 : 0.6, isBrute ? 1.0 : 0.6, isBrute ? 2.2 : 1.8, 8);
            const bodyMat = new THREE.MeshStandardMaterial({ color: isBrute ? 0x991b1b : 0x1e3a8a, roughness: 0.7 });
            const bodyMesh = new THREE.Mesh(bodyGeo, bodyMat);
            bodyMesh.position.y = isBrute ? 1.3 : 1.0;
            bodyMesh.castShadow = true;
            zombieGroup.add(bodyMesh);


            const eyeGeo = new THREE.SphereGeometry(0.08, 6, 6);
            const eyeMat = new THREE.MeshBasicMaterial({ color: 0xf59e0b });
           
            const leftEye = new THREE.Mesh(eyeGeo, eyeMat);
            leftEye.position.set(0.2, isBrute ? 2.0 : 1.5, -0.3);
            zombieGroup.add(leftEye);


            const rightEye = new THREE.Mesh(eyeGeo, eyeMat);
            rightEye.position.set(-0.2, isBrute ? 2.0 : 1.5, -0.3);
            zombieGroup.add(rightEye);


            let x, z;
            do {
                x = (Math.random() - 0.5) * 360;
                z = (Math.random() - 0.5) * 360;
            } while (Math.hypot(x - player.x, z - player.z) < 45);


            zombieGroup.position.set(x, 0, z);
            scene.add(zombieGroup);


            // Create DOM Health bar element for this zombie
            const hpBarContainer = document.createElement('div');
            hpBarContainer.className = 'zombie-hp-bar-container';
            const hpFill = document.createElement('div');
            hpFill.className = 'zombie-hp-fill';
            hpBarContainer.appendChild(hpFill);
            document.getElementById('zombieHealthBarsOverlay').appendChild(hpBarContainer);
            hpBarContainer.style.display = 'block';


            zombies.push({
                group: zombieGroup,
                hpElement: hpBarContainer,
                hpFillElement: hpFill,
                x: x,
                z: z,
                radius: isBrute ? 1.1 : 0.7,
                hp: isBrute ? 140 : 45,
                maxHp: isBrute ? 140 : 45,
                speed: isBrute ? 0.08 + wave * 0.005 : 0.11 + wave * 0.008,
                isBrute: isBrute,
                animTimer: Math.random() * Math.PI
            });
        }


        function dropWeaponAt(x, z) {
            // Determine weapon type dropped randomly (PISTOL, SNIPER, MACHINEGUN)
            const rand = Math.random();
            let weaponType = 'PISTOL';
            let colorHex = 0x64748b;
            if(rand > 0.65) {
                weaponType = 'SNIPER';
                colorHex = 0x0284c7;
            } else if(rand > 0.3) {
                weaponType = 'MACHINEGUN';
                colorHex = 0xd97706;
            }


            // Create 3D Pickup model on the ground
            const dropGroup = new THREE.Group();
            const boxGeo = new THREE.BoxGeometry(0.6, 0.25, 0.8);
            const boxMat = new THREE.MeshStandardMaterial({ color: colorHex, metalness: 0.8, roughness: 0.3 });
            const dropMesh = new THREE.Mesh(boxGeo, boxMat);
            dropMesh.position.y = 0.2;
            dropMesh.castShadow = true;
            dropGroup.add(dropMesh);


            // Add glowing aura marker
            const auraGeo = new THREE.RingGeometry(0.5, 0.7, 16);
            auraGeo.rotateX(-Math.PI / 2);
            const auraMat = new THREE.MeshBasicMaterial({ color: colorHex, side: THREE.DoubleSide, transparent: true, opacity: 0.7 });
            const auraMesh = new THREE.Mesh(auraGeo, auraMat);
            auraMesh.position.y = 0.02;
            dropGroup.add(auraMesh);


            dropGroup.position.set(x, 0, z);
            scene.add(dropGroup);


            droppedWeapons.push({
                group: dropGroup,
                x: x,
                z: z,
                type: weaponType,
                name: WEAPONS[weaponType].name
            });
        }


        function checkWeaponPickups() {
            for (let i = droppedWeapons.length - 1; i >= 0; i--) {
                let d = droppedWeapons[i];
                let dist = Math.hypot(d.x - player.x, d.z - player.z);
                // Auto-catch/pickup range when player walks over the dropped weapon
                if (dist < 2.5) {
                    switchWeapon(d.type);
                    scene.remove(d.group);
                    droppedWeapons.splice(i, 1);
                }
            }
        }


        function startWave() {
            zombiesToSpawn = 6 + wave * 5;
            waveTimer = 0;
            addLog(`--- WAVE ${wave}: NIGHT HORDE APPROACHING ---`);
            document.getElementById('waveDisplay').innerText = wave;
        }


        function addLog(msg) {
            const feed = document.getElementById('killFeed');
            const item = document.createElement('div');
            item.className = 'bg-slate-900/85 px-3 py-1.5 rounded-lg border border-slate-800 text-[11px] text-slate-300 shadow';
            item.innerText = msg;
            feed.prepend(item);
            if(feed.children.length > 4) feed.lastChild.remove();
            setTimeout(() => item.remove(), 6000);
        }


        function reloadWeapon() {
            if (player.isReloading || player.ammo === player.maxAmmo || player.reserveAmmo <= 0) return;
            player.isReloading = true;
            player.reloadTimer = 1.5;
            addLog('Reloading magazine...');
        }


        function updateAmmoBar() {
            const ammoPercent = (player.ammo / player.maxAmmo) * 100;
            document.getElementById('ammoBarFill').style.width = `${ammoPercent}%`;
            document.getElementById('ammoBarText').innerText = `${player.ammo} / ${player.maxAmmo}`;
            document.getElementById('ammoCurrent').innerText = player.ammo;
            document.getElementById('ammoReserve').innerText = player.reserveAmmo;
        }


        function shootBullet() {
            if (player.isReloading || player.ammo <= 0) return;
           
            const wData = WEAPONS[player.currentWeaponKey];
            const now = performance.now();
            if(now - player.lastShotTime < wData.fireRate * 1000) return;
            player.lastShotTime = now;


            player.ammo--;
            updateAmmoBar();


            player.recoilPitch += (player.currentWeaponKey === 'SNIPER' ? 0.08 : 0.035);


            // Muzzle position in 3D world space
            const muzzleOffset = new THREE.Vector3(0.25, -0.2, -0.85);
            muzzleOffset.applyEuler(camera.rotation);
            const muzzlePos = camera.position.clone().add(muzzleOffset);


            const speed = wData.speed;
            const vx = -Math.sin(mouseX) * speed;
            const vz = -Math.cos(mouseX) * speed;
            const vy = (Math.sin(-mouseY) + (Math.random() - 0.5) * 0.05) * speed;


            // Guaranteed Ray Ammo tracer beam for ALL weapons
            const rayColor = wData.tracerColor;


            // Create a long continuous ray tracer beam cylinder for every gun
            const rayGeo = new THREE.CylinderGeometry(0.06, 0.06, 5.0, 6);
            rayGeo.rotateX(Math.PI / 2);
            const rayMat = new THREE.MeshBasicMaterial({ color: rayColor, transparent: true, opacity: 0.98 });
            const rayMesh = new THREE.Mesh(rayGeo, rayMat);


            rayMesh.position.copy(muzzlePos);
            rayMesh.lookAt(muzzlePos.clone().add(new THREE.Vector3(vx, vy, vz)));
            scene.add(rayMesh);


            bullets.push({
                mesh: rayMesh,
                x: muzzlePos.x,
                y: muzzlePos.y,
                z: muzzlePos.z,
                vx: vx,
                vy: vy,
                vz: vz,
                damage: wData.damage,
                distance: 0
            });


            createParticles(muzzlePos.x, muzzlePos.y, muzzlePos.z, rayColor === 0x38bdf8 ? '#38bdf8' : (rayColor === 0xf97316 ? '#f97316' : '#facc15'), 8, 1.2);


            if(player.ammo === 0) {
                reloadWeapon();
            }
        }


        function createParticles(x, y, z, color, count = 8, speedMult = 1) {
            for (let i = 0; i < count; i++) {
                const pGeo = new THREE.SphereGeometry(0.07, 4, 4);
                const pMat = new THREE.MeshBasicMaterial({ color: color });
                const pMesh = new THREE.Mesh(pGeo, pMat);
                pMesh.position.set(x, y, z);
                scene.add(pMesh);


                const angle = Math.random() * Math.PI * 2;
                const pSpeed = (Math.random() * 0.2 + 0.05) * speedMult;
                particles.push({
                    mesh: pMesh,
                    vx: Math.cos(angle) * pSpeed,
                    vy: (Math.random() - 0.3) * pSpeed,
                    vz: Math.sin(angle) * pSpeed,
                    life: 0.35,
                    maxLife: 0.35
                });
            }
        }


        function triggerDamageFlash() {
            const flash = document.getElementById('damageFlash');
            flash.style.opacity = '1';
            setTimeout(() => { flash.style.opacity = '0'; }, 150);
        }


        function startGame() {
            score = 0;
            wave = 1;
            player.health = player.maxHealth;
            player.currentWeaponKey = 'RIFLE';
            player.maxAmmo = WEAPONS['RIFLE'].maxAmmo;
            player.ammo = player.maxAmmo;
            player.reserveAmmo = 120;
            player.x = 0;
            player.z = 0;
            mouseX = 0;
            mouseY = 0;


            updateAmmoBar();
            buildWeaponMesh();
            document.getElementById('weaponName').innerText = WEAPONS['RIFLE'].name;
            document.getElementById('hpText').innerText = `${player.health} / 100`;
            document.getElementById('healthBar').style.width = '100%';


            // Clear entities & health bars
            zombies.forEach(z => {
                scene.remove(z.group);
                if(z.hpElement) z.hpElement.remove();
            });
            zombies = [];
            droppedWeapons.forEach(d => scene.remove(d.group));
            droppedWeapons = [];
            bullets.forEach(b => scene.remove(b.mesh));
            bullets = [];


            startWave();


            document.getElementById('startScreen').classList.add('hidden');
            document.getElementById('gameOverScreen').classList.add('hidden');
            document.getElementById('hud').classList.remove('hidden');
            gameState = 'PLAYING';
            document.body.requestPointerLock();
        }


        function gameOver() {
            gameState = 'GAMEOVER';
            document.getElementById('hud').classList.add('hidden');
            document.getElementById('gameOverScreen').classList.remove('hidden');
            document.getElementById('finalKills').innerText = score;
            document.getElementById('finalWave').innerText = wave;
            // Clean up zombie health bar DOM elements on game over
            zombies.forEach(z => {
                if(z.hpElement) z.hpElement.remove();
            });
            document.exitPointerLock();
        }


        // --- UPDATE LOOP ---
        let lastTime = performance.now();
        function animate(timestamp) {
            requestAnimationFrame(animate);


            const dt = (timestamp - lastTime) / 1000;
            lastTime = timestamp;


            if (gameState === 'PLAYING') {
                // Reload timer
                if (player.isReloading) {
                    player.reloadTimer -= dt;
                    if (player.reloadTimer <= 0) {
                        player.isReloading = false;
                        let needed = player.maxAmmo - player.ammo;
                        let reloadAmount = Math.min(needed, player.reserveAmmo);
                        player.ammo += reloadAmount;
                        player.reserveAmmo -= reloadAmount;
                        updateAmmoBar();
                        addLog('Weapon reloaded.');
                    }
                }


                // Rotate star field gently overhead
                if(starField) starField.rotation.y += dt * 0.005;


                // Sprinting & Stamina
                let isSprinting = (keys['ShiftLeft'] || keys['ShiftRight']) && (keys['KeyW'] || keys['KeyA'] || keys['KeyS'] || keys['KeyD']) && !player.isADS;
                if (isSprinting && player.stamina > 0) {
                    player.isSprinting = true;
                    player.stamina = Math.max(0, player.stamina - dt * 35);
                } else {
                    player.isSprinting = false;
                    player.stamina = Math.min(player.maxStamina, player.stamina + dt * 25);
                }
                document.getElementById('staminaText').innerText = `${Math.floor((player.stamina / player.maxStamina) * 100)}%`;
                document.getElementById('staminaBar').style.width = `${(player.stamina / player.maxStamina) * 100}%`;


                // Player Movement
                let moveDir = new THREE.Vector3();
                if (keys['KeyW'] || keys['ArrowUp']) moveDir.z -= 1;
                if (keys['KeyS'] || keys['ArrowDown']) moveDir.z += 1;
                if (keys['KeyA'] || keys['ArrowLeft']) moveDir.x -= 1;
                if (keys['KeyD'] || keys['ArrowRight']) moveDir.x += 1;
                moveDir.normalize();


                moveDir.applyAxisAngle(new THREE.Vector3(0, 1, 0), mouseX);
                let currentSpeed = player.speed * (player.isSprinting ? player.sprintMultiplier : 1.0);
                if(player.isADS) currentSpeed *= 0.5;


                player.x += moveDir.x * currentSpeed;
                player.z += moveDir.z * currentSpeed;


                // Continuous Shooting
                if (isMouseDown && !player.isReloading) {
                    shootBullet();
                }


                // Recoil recovery
                player.recoilPitch *= 0.85;


                // --- CAMERA & WEAPON SWAY UPDATE ---
                camera.position.set(player.x, player.y + mouseY * 2 + player.recoilPitch, player.z);
                camera.rotation.order = 'YXZ';
                camera.rotation.y = mouseX;
                camera.rotation.x = mouseY;


                // Weapon ADS positioning smoothly
                if (weaponMeshGroup) {
                    let targetX = player.isADS ? 0 : 0.25;
                    let targetY = player.isADS ? -0.15 : -0.22;
                    let targetZ = player.isADS ? -0.45 : -0.5;
                    weaponMeshGroup.position.x += (targetX - weaponMeshGroup.position.x) * 0.2;
                    weaponMeshGroup.position.y += (targetY - weaponMeshGroup.position.y) * 0.2;
                    weaponMeshGroup.position.z += (targetZ - weaponMeshGroup.position.z) * 0.2;


                    weaponMeshGroup.position.y += Math.sin(timestamp * 0.006) * 0.0015;
                }


                // --- CHECK WEAPON AUTO-CATCH PROXIMITY ---
                checkWeaponPickups();


                // --- ZOMBIE SPAWNING & AI ---
                if (zombiesToSpawn > 0) {
                    waveTimer += dt;
                    if (waveTimer >= 1.0) {
                        spawnZombie();
                        zombiesToSpawn--;
                        waveTimer = 0;
                    }
                } else if (zombies.length === 0) {
                    wave++;
                    startWave();
                }


                for (let i = zombies.length - 1; i >= 0; i--) {
                    let z = zombies[i];
                    const dir = new THREE.Vector3(player.x - z.x, 0, player.z - z.z);
                    const dist = dir.length();
                    dir.normalize();


                    if (dist > 2.0) {
                        z.x += dir.x * z.speed;
                        z.z += dir.z * z.speed;
                        z.group.position.set(z.x, 0, z.z);
                        z.group.lookAt(player.x, 0, player.z);


                        z.animTimer += dt * 10;
                        z.group.position.y = Math.abs(Math.sin(z.animTimer)) * 0.2;
                    } else {
                        player.health -= dt * (z.isBrute ? 30 : 20);
                        triggerDamageFlash();
                        document.getElementById('hpText').innerText = `${Math.max(0, Math.floor(player.health))} / 100`;
                        document.getElementById('healthBar').style.width = `${Math.max(0, player.health)}%`;


                        if (player.health <= 0) {
                            gameOver();
                        }
                    }


                    // --- UPDATE 3D HEALTH BAR PROJECTION ON SCREEN ---
                    if (z.hpElement) {
                        const topPos = new THREE.Vector3(z.x, z.isBrute ? 3.2 : 2.4, z.z);
                        topPos.project(camera);
                        const halfW = window.innerWidth / 2;
                        const halfH = window.innerHeight / 2;
                        const screenX = topPos.x * halfW + halfW;
                        const screenY = -topPos.y * halfH + halfH;


                        // Check if zombie is in front of camera and within view
                        if (topPos.z < 1.0 && screenX >= 0 && screenX <= window.innerWidth && screenY >= 0 && screenY <= window.innerHeight) {
                            z.hpElement.style.display = 'block';
                            z.hpElement.style.left = `${screenX}px`;
                            z.hpElement.style.top = `${screenY}px`;
                            const hpPct = Math.max(0, (z.hp / z.maxHp) * 100);
                            z.hpFillElement.style.width = `${hpPct}%`;
                        } else {
                            z.hpElement.style.display = 'none';
                        }
                    }
                }


                // --- BULLET UPDATES & COLLISIONS ---
                for (let i = bullets.length - 1; i >= 0; i--) {
                    let b = bullets[i];
                   
                    b.x += b.vx;
                    b.y += b.vy;
                    b.z += b.vz;
                    b.mesh.position.set(b.x, b.y, b.z);
                    b.distance += Math.hypot(b.vx, b.vy, b.vz);


                    if (b.distance > 220) {
                        scene.remove(b.mesh);
                        bullets.splice(i, 1);
                        continue;
                    }


                    let hit = false;
                    for (let j = zombies.length - 1; j >= 0; j--) {
                        let z = zombies[j];
                        // Robust 3D distance collision check against zombie radius
                        let distToZombie = Math.hypot(b.x - z.x, b.z - z.z);
                        if (distToZombie < z.radius + 1.5 && b.y >= -0.2 && b.y <= 3.8) {
                            z.hp -= b.damage;
                            createParticles(b.x, b.y, b.z, '#ef4444', 12, 1.5);
                            hit = true;


                            // Immediate visual feedback on hit: briefly flash zombie red
                            z.group.traverse(child => {
                                if (child.isMesh && child.material && child.material.color) {
                                    if (!child.userData.originalColor) child.userData.originalColor = child.material.color.getHex();
                                    child.material.color.setHex(0xffffff);
                                    setTimeout(() => {
                                        if (child && child.material && child.userData.originalColor) {
                                            child.material.color.setHex(child.userData.originalColor);
                                        }
                                    }, 80);
                                }
                            });


                            if (z.hp <= 0) {
                                if (z.hpElement) z.hpElement.remove();
                                dropWeaponAt(z.x, z.z); // Drop weapon on death
                                scene.remove(z.group);
                                zombies.splice(j, 1);
                                score++;
                                document.getElementById('scoreDisplay').innerText = score;
                                addLog(z.isBrute ? 'Brute zombie eliminated! Weapon dropped.' : 'Zombie eliminated! Weapon dropped.');
                            }
                            break;
                        }
                    }


                    if (hit) {
                        scene.remove(b.mesh);
                        bullets.splice(i, 1);
                    }
                }


                // --- PARTICLES UPDATE ---
                for (let i = particles.length - 1; i >= 0; i--) {
                    let p = particles[i];
                    p.mesh.position.x += p.vx;
                    p.mesh.position.y += p.vy;
                    p.mesh.position.z += p.vz;
                    p.life -= dt;
                    if (p.life <= 0) {
                        scene.remove(p.mesh);
                        particles.splice(i, 1);
                    }
                }


                // --- MINIMAP RENDERING ---
                minimapCtx.clearRect(0, 0, minimapCanvas.width, minimapCanvas.height);
                const mapScale = 0.6;
                const cx = minimapCanvas.width / 2;
                const cy = minimapCanvas.height / 2;


                minimapCtx.save();
                minimapCtx.translate(cx, cy);
                minimapCtx.rotate(-mouseX);
                minimapCtx.fillStyle = '#22d3ee';
                minimapCtx.beginPath();
                minimapCtx.moveTo(0, -8);
                minimapCtx.lineTo(6, 6);
                minimapCtx.lineTo(-6, 6);
                minimapCtx.closePath();
                minimapCtx.fill();
                minimapCtx.restore();


                // Draw dropped weapons on minimap (Yellow dots)
                minimapCtx.fillStyle = '#fbbf24';
                droppedWeapons.forEach(d => {
                    let dx = cx + (d.x - player.x) * mapScale;
                    let dz = cy + (d.z - player.z) * mapScale;
                    if (Math.hypot(dx - cx, dz - cy) < minimapCanvas.width / 2) {
                        minimapCtx.beginPath();
                        minimapCtx.arc(dx, dz, 3, 0, Math.PI * 2);
                        minimapCtx.fill();
                    }
                });


                minimapCtx.fillStyle = '#ef4444';
                zombies.forEach(z => {
                    let zx = cx + (z.x - player.x) * mapScale;
                    let zz = cy + (z.z - player.z) * mapScale;
                    if (Math.hypot(zx - cx, zz - cy) < minimapCanvas.width / 2) {
                        minimapCtx.beginPath();
                        minimapCtx.arc(zx, zz, z.isBrute ? 4.5 : 3, 0, Math.PI * 2);
                        minimapCtx.fill();
                    }
                });
            }


            renderer.render(scene, camera);
        }


        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }


        document.getElementById('startButton').addEventListener('click', startGame);
        document.getElementById('restartButton').addEventListener('click', startGame);


        init();
        requestAnimationFrame(animate);
    </script>
</body>
</html>

